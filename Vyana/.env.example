# ==============================================================================
# Vyana Care Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root:
#    cp .env.example .env
# 2. Fill in the required API keys and credentials for your environment.
# 3. DO NOT commit your real .env file with secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (Production / Staging)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vyana_care

# Optional explicit SQLite fallback URL if PostgreSQL is unavailable
SQLITE_FALLBACK_URL=sqlite:///./vyana.db

# ------------------------------------------------------------------------------
# 2. AI & SPEECH-TO-TEXT SERVICES
# ------------------------------------------------------------------------------
# Groq Whisper API Key (Used for fast Hindi/Hinglish speech-to-text voice consultations)
# Get a key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Used for clinical extraction, triage risk models & moderation)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Recommended: models/gemini-2.5-flash or models/gemini-flash-latest)
GEMINI_MODEL_NAME=models/gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. TELEPHONY & EMERGENCY SERVICES (TWILIO)
# ------------------------------------------------------------------------------
# Twilio Account SID & Auth Token (Used for automated emergency IVR calls & SMS alerts)
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Outgoing Twilio registered phone number (E.164 format: e.g. +16624986357)
TWILIO_FROM_NUMBER=+10000000000

# Sandbox test destination phone number (Used during demo/sandbox mode)
TWILIO_TO_NUMBER=+910000000000

# Public webhook URL for interactive voice responses (e.g. https://your-domain.com/ivr)
TWILIO_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 4. EMERGENCY HOTLINES & DISPATCH CONTACTS
# ------------------------------------------------------------------------------
# Government 108 Ambulance Dispatch Hotline
EMERGENCY_AMBULANCE_NUMBER=108

# Village ASHA Worker Emergency Contact
EMERGENCY_ASHA_PHONE=9876543210

# Nearest Primary Health Centre (PHC) Emergency Contact
EMERGENCY_PHC_PHONE=9000010001

# Default Assigned 108 Ambulance Driver Contact
DEFAULT_DRIVER_PHONE=9876543210

# ------------------------------------------------------------------------------
# 5. PUSH NOTIFICATIONS & CLOUD (FIREBASE ADMIN SDK)
# ------------------------------------------------------------------------------
# Path to service account JSON file OR raw JSON string containing credentials
# Get it from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_CREDENTIALS_JSON=./vyana-care-firebase-adminsdk-fbsvc-c55b228241.json

# ------------------------------------------------------------------------------
# 6. GOVERNMENT INTEGRATIONS (AYUSHMAN BHARAT ABHA)
# ------------------------------------------------------------------------------
# ABHA Sandbox API Key for 14-digit Digital Health ID verification
ABHA_SANDBOX_API_KEY=your_abha_sandbox_api_key_here
ABHA_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5

# ------------------------------------------------------------------------------
# 7. SECURITY, TOKENS & ESCALATION TIMINGS
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens and internal HMAC digests
JWT_SECRET_KEY=replace_with_a_secure_random_string_in_production
JWT_ALGORITHM=HS256

# Token expiration time in hours
VYANA_TOKEN_TTL_HOURS=72

# Delay in seconds between escalation levels (Demo: 15 seconds, Production: 60-300 seconds)
DEMO_ESCALATION_SECONDS=15

# Role Access Codes (Used for quick role switching/demo sign-in)
VYANA_PATIENT_ACCESS_CODE=patient-1234
VYANA_ASHA_ACCESS_CODE=asha-1234
VYANA_DISTRICT_ACCESS_CODE=district-1234
VYANA_ADMIN_ACCESS_CODE=admin-1234

# ------------------------------------------------------------------------------
# 8. CORS & FRONTEND ORIGIN CONFIGURATION
# ------------------------------------------------------------------------------
# Production Frontend URL
FRONTEND_URL=https://your-vyana-frontend.vercel.app

# Additional comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
