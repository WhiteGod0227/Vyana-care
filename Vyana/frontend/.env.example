# ==============================================================================
# Vyana Care Frontend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (or '.env.local') inside the frontend directory:
#    cp .env.example .env
# 2. Configure the API Base URL to point to your FastAPI backend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API BASE URL
# ------------------------------------------------------------------------------
# Local development backend URL
VITE_API_BASE_URL=http://127.0.0.1:8001

# For production deployment (e.g. Railway / Render / AWS):
# VITE_API_BASE_URL=https://your-vyana-backend.railway.app

# ------------------------------------------------------------------------------
# 2. EMERGENCY HOTLINE CONTACT NUMBERS
# ------------------------------------------------------------------------------
# 108 Government Ambulance Emergency Number
VITE_HOTLINE_AMBULANCE=108

# ASHA Worker Public Contact Number
VITE_HOTLINE_ASHA=9876543210

# Primary Health Centre (PHC) Contact Number
VITE_HOTLINE_PHC=9000010001

# ------------------------------------------------------------------------------
# 3. FIREBASE WEB CONFIGURATION (OPTIONAL FOR BROWSER PUSH NOTIFICATIONS)
# ------------------------------------------------------------------------------
# Raw JSON string of your Firebase web app config from Firebase Console:
# Example: {"apiKey":"...","authDomain":"...","projectId":"..."}
VITE_FIREBASE_CONFIG={}
